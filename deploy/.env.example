# ---- Postgres superuser ----
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
# ---- PostgREST login role (role 'authenticator') ----
AUTHENTICATOR_PASSWORD=CHANGE-ME-strong-authenticator-password
# ---- Web ----
HTTP_PORT=8080
# ---- OPTIONAL: Microsoft 365 / Entra ID SSO (oauth2-proxy) ----
# OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# OAUTH2_PROXY_CLIENT_ID=<app-registration-client-id>
# OAUTH2_PROXY_CLIENT_SECRET=<app-registration-secret>
# OAUTH2_PROXY_COOKIE_SECRET=<32-byte-base64-random>
